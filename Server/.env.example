# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=5000

# Local MongoDB by default; use your own connection string when needed.
MONGO_URI=mongodb://localhost:27017/dengueguard

# Local-only development secret. Replace with a random secret of 32+ characters
# for production; production startup rejects missing/short values.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Used by the seed script for demo accounts; change before seeding.
SEED_PASSWORD=change-this-demo-password

# Optional integrations.
AI_SERVICE_URL=http://127.0.0.1:5001
NDCU_DAILY_REPORT_URL=https://www.dengue.health.gov.lk/daily-reports/
EMAIL_USER=
EMAIL_PASS=
