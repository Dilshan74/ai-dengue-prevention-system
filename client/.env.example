# Frontend Environment Variables
# Copy this file to .env before starting the development server

# Backend API Base URL (default is port 5000 or 5050 depending on your server PORT)
VITE_API_URL=http://localhost:5000/api

# Google Maps API Key (Optional: Map components will automatically fallback to OpenStreetMap / Leaflet if left empty)
VITE_GOOGLE_MAPS_API_KEY=
